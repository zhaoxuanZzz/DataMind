{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: FastAPI 后端",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "${workspaceFolder}/backend/app"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "python": "${command:python.interpreterPath}",
      "subProcess": true
    },
    {
      "name": "Python: FastAPI 后端（无重载）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "console": "integratedTerminal",
      "python": "${command:python.interpreterPath}",
      "subProcess": true
    },
    {
      "name": "Python: FastAPI 后端（当前文件）",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/backend"
      },
      "justMyCode": true,
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "前端: Vite Dev Server",
      "type": "node",
      "request": "launch",
      "name": "Launch Frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "复合: 启动所有服务",
      "type": "node",
      "request": "launch",
      "preLaunchTask": "启动所有服务",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "前后端同时启动",
      "configurations": [
        "Python: FastAPI 后端",
        "前端: Vite Dev Server"
      ],
      "stopAll": true,
      "presentation": {
        "hidden": false,
        "group": "",
        "order": 1
      }
    }
  ]
}

