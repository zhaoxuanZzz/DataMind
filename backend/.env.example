# ============================================
# DataMind 环境变量配置示例
# ============================================
# 复制此文件为 .env 并修改相应的配置值
# cp .env.example .env

# ============================================
# 应用基础配置
# ============================================
APP_NAME=DataMind
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# ============================================
# API 配置
# ============================================
API_PREFIX=/api/v1
# CORS 允许的源，多个用逗号分隔
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================
# 数据库配置
# ============================================
# 使用 PostgreSQL（推荐生产环境，配合 docker-compose.yml）
DATABASE_URL=postgresql://datamind:datamind123@localhost:5432/datamind

# 或使用 SQLite（开发环境）
# DATABASE_URL=sqlite:///./datamind.db

# ============================================
# Redis 配置（可选，用于缓存）
# ============================================
# 如果使用 Docker Compose，Redis 在 localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# ============================================
# 安全配置
# ============================================
# 生产环境必须修改此密钥！
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================
# 查询执行配置
# ============================================
QUERY_TIMEOUT=30
MAX_QUERY_ROWS=10000
ENABLE_QUERY_CACHE=True
CACHE_TTL=300

# ============================================
# 模型网关配置
# ============================================
MODEL_GATEWAY_ENABLED=True
MODEL_REQUEST_TIMEOUT=60
MODEL_MAX_RETRIES=3

# ============================================
# 向量库配置
# ============================================
# ChromaDB 持久化目录
CHROMADB_PERSIST_DIRECTORY=./chroma_db

# Milvus 配置（如果使用 Docker Compose，默认在 localhost:19530）
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ============================================
# 可观测性配置
# ============================================
ENABLE_TRACING=True
ENABLE_METRICS=True

# ============================================
# LLM API 密钥配置（可选）
# ============================================
# 这些密钥可以通过 API 动态配置，也可以在这里设置默认值
# OPENAI_API_KEY=sk-...
# ALIYUN_API_KEY=...
# DOUBAO_API_KEY=...
# KIMI_API_KEY=...

# ============================================
# 数据源连接配置示例（可选）
# ============================================
# 这些配置通常通过 API 动态管理，加密存储在数据库中
# 以下仅为示例，实际使用时通过数据源管理 API 配置

# MySQL 示例
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=password
# MYSQL_DATABASE=test

# PostgreSQL 示例（除了主数据库外的其他 PostgreSQL 实例）
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=password
# POSTGRES_DATABASE=test